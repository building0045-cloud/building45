rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /buildings/{b} {

      function memberPath() {
        return /databases/$(database)/documents/buildings/$(b)/members/$(request.auth.uid);
      }
      function isMember() {
        return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true;
      }
      function isAdmin() {
        return isMember() && get(memberPath()).data.role == 'admin';
      }
      function isStaff() {
        return isMember() && get(memberPath()).data.role in ['admin', 'treasurer'];
      }
      function isOwner() {
        return signedIn()
          && get(/databases/$(database)/documents/buildings/$(b)).data.ownerUid == request.auth.uid;
      }

      // Holds only the building name and owner; any signed-in account may
      // check whether it exists. The first account to create it owns it.
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.ownerUid == resource.data.ownerUid;

      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow read: if isStaff();
        // The owner can always (re)create their own admin membership.
        allow create: if isAdmin()
          || (isOwner() && request.auth.uid == uid
              && request.resource.data.role == 'admin'
              && request.resource.data.active == true);
        // The owner's membership cannot be changed by other admins.
        allow update: if isAdmin()
          && get(/databases/$(database)/documents/buildings/$(b)).data.ownerUid != uid;
      }

      match /accessRequests/{uid} {
        allow get, create: if signedIn() && request.auth.uid == uid;
        allow read, delete: if isAdmin();
      }

      match /apartments/{id} {
        allow read: if isStaff();
        allow create, update: if isStaff();
        allow delete: if isAdmin();
      }

      match /settings/{doc} {
        allow read: if isStaff();
        allow write: if isAdmin();
      }

      // Contribution records: cells imported from the old spreadsheet (kept
      // with their source and original text) plus edits made in the app.
      match /importItems/{id} {
        allow read: if isStaff();
        allow create, update: if isStaff();
        allow delete: if isAdmin();
      }

      // Money movements. Never deleted: corrections change the amount or
      // cancel the entry, and both are recorded in the audit log.
      match /transactions/{id} {
        function validAmount() {
          return request.resource.data.amount is int && request.resource.data.amount > 0;
        }
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type in ['income', 'subscription', 'project', 'expense']
          && validAmount();
        allow update: if isStaff()
          && request.resource.data.type == resource.data.type
          && (resource.data.type != 'opening' || isAdmin())
          && validAmount();
      }

      // One lock per apartment and month while a subscription payment covers
      // it. Locks are never updated, so a month cannot be paid twice; they
      // must match the payment written in the same batch.
      match /subscriptionLocks/{id} {
        function txAfter(txId) {
          return getAfter(/databases/$(database)/documents/buildings/$(b)/transactions/$(txId));
        }
        allow read: if isStaff();
        allow create: if isStaff()
          && id == request.resource.data.period + '_' + string(request.resource.data.apartmentNumber)
          && txAfter(request.resource.data.txId).data.type == 'subscription'
          && txAfter(request.resource.data.txId).data.voided == false
          && txAfter(request.resource.data.txId).data.apartmentNumber == request.resource.data.apartmentNumber
          && request.resource.data.period in txAfter(request.resource.data.txId).data.periods;
        allow delete: if isStaff()
          && (txAfter(resource.data.txId).data.voided == true
              || !(resource.data.period in txAfter(resource.data.txId).data.periods));
      }

      // Projects created in the app: name, icon, total and each
      // apartment's share. Admins manage them; they are never deleted.
      match /projects/{id} {
        allow read: if isStaff();
        allow create, update: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.total is int
          && request.resource.data.total > 0;
      }

      // Append-only history of financial and permission changes.
      match /auditLog/{id} {
        allow read: if isStaff();
        allow create: if isStaff() && request.resource.data.by == request.auth.uid;
      }

      // The only world-readable data: what the admin chose to publish.
      match /public/{doc} {
        allow read: if true;
        allow write: if isStaff();
      }
    }
  }
}
